Item_Type :: enum u8 { None, Plant_Fiber, Wheat, Flour, Dough, Bagel, Paprika, Smoked_Pepper, Rat_Body, Rat_Tail, Cooked_Rat, Seasoned_Rat, Rat_Corpse, Rock, Clay, Pepper, Sharp_Rock, Twine, Torch, Charcoal, Straw_Hat, Unfired_Pot, Clay_Pot, Cracked_Pot, Water_Pot, Hatchet, Stick, Energy_Herb }

Item_Flag :: enum u8 { Is_Armor, Is_Cutting_Tool, Is_Weapon }

// How an item is named in lists (FullName.lua): the plain name, or the name with durability: Stick(10/10).
Full_Name :: enum u8 { Plain, With_Durability }

Item_Stats :: struct { attack_dice, max_attack, defend_dice, max_defend, durability, max_durability: i32 }

MAX_ITEM_EFFECTS :: 3

Item_Info :: struct {
	name:      string,
	glyph:     u8,
	hue:       Hue,
	slot:      Equip_Slot,
	flags:     bit_set[Item_Flag],
	stats:     Item_Stats, // what a new item starts with
	full_name: Full_Name,
	effects:   [MAX_ITEM_EFFECTS]Effect_Kind, // the item menu's verbs, in the original's order
}

